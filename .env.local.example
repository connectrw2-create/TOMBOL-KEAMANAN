# Convex Auth - JWT Private Key (RSA)
# This key is used by Convex Auth to sign JWT tokens.
# JANGAN dicopy dari sini — generate baru dengan: npx @convex-dev/auth
# (perintah itu akan mengisi file .env.local kamu secara otomatis)
JWT_PRIVATE_KEY=

# URL aplikasi (update sesuai deployment)
SITE_URL=http://localhost:5173

# Convex URL (isi otomatis oleh 'npx convex dev' saat pertama kali dijalankan)
VITE_CONVEX_URL=

# Deployment used by `npx convex dev` (diisi otomatis)
CONVEX_DEPLOYMENT=

VITE_CONVEX_SITE_URL=

# ── Fase 2: Web Push ──────────────────────────────────────────────────────
# Public key AMAN untuk dibagi/commit. Private key JANGAN — set di Convex
# Dashboard (Settings > Environment Variables), bukan di sini.
# Generate dengan: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# ── Fase 3: Fallback WhatsApp ke kontak darurat ──────────────────────────
# FONNTE_TOKEN di-set di Convex Dashboard (bukan di sini), dari dashboard
# fonnte.com setelah scan QR dengan nomor WA cadangan.
